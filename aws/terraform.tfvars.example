# Copy this file to terraform.tfvars and fill in the values below:
#   cp terraform.tfvars.example terraform.tfvars

project_name = "tofu-starter"
environment  = "dev"
aws_region   = "us-east-1"

# REQUIRED - no default is provided on purpose. Set this to YOUR OWN public
# IP address in CIDR notation so SSH isn't open to the whole internet.
# Find your public IP with: curl ifconfig.me
# Example: allowed_ssh_cidr = "203.0.113.10/32"
allowed_ssh_cidr = ""

# REQUIRED - no default is provided. Paste the contents of your SSH public
# key (e.g. `cat ~/.ssh/id_ed25519.pub`). Generate one with:
# ssh-keygen -t ed25519
ssh_public_key = ""

instance_type     = "t3.micro"
db_instance_class = "db.t3.micro"
cache_node_type   = "cache.t3.micro"
db_username       = "appuser"

# Optional: extra environment variables passed to each app (merged on top of
# the fixed APP_PORT/MYSQL_*/REDIS_* ones this module sets automatically).
# See ../apps/README.md#environment-variables.
# node_env = {
#   LOG_LEVEL = "debug"
# }
# python_env = {}
# php_env    = {}

# REQUIRED, sensitive - no default is provided. Choose a strong password
# (8-41 characters). Do not commit this file with a real value filled in;
# terraform.tfvars is already gitignored. You may instead set this via the
# TF_VAR_db_password environment variable and leave it blank here.
db_password = ""
